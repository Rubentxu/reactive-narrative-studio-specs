{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative.dev/schemas/control-plane-project-v1.json",
  "title": "Control Plane Project Projection",
  "type": "object",
  "required": [
    "schema",
    "generatedAt",
    "sourceRevision",
    "project",
    "lifecycle",
    "checks",
    "progress"
  ],
  "properties": {
    "schema": {
      "const": "control-plane/project/v1"
    },
    "generatedAt": {
      "type": "string"
    },
    "sourceRevision": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "audienceProfile": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "string"
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "pass",
          "warning",
          "blocked",
          "pending",
          "unknown"
        ]
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "completed",
          "total"
        ],
        "properties": {
          "completed": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "blocking": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "cp-scm": {
      "$ref": "https://narrative.dev/schemas/cp-scm.schema.json"
    },
    "cp-uat": {
      "$ref": "https://narrative.dev/schemas/cp-uat.schema.json"
    },
    "cp-costs": {
      "$ref": "https://narrative.dev/schemas/cp-costs.schema.json"
    },
    "cp-graph": {
      "$ref": "https://narrative.dev/schemas/cp-graph.schema.json"
    },
    "cp-assets": {
      "$ref": "https://narrative.dev/schemas/cp-assets.schema.json"
    },
    "cp-history": {
      "$ref": "https://narrative.dev/schemas/cp-history.schema.json"
    },
    "cp-project": {
      "$ref": "https://narrative.dev/schemas/cp-project.schema.json"
    },
    "cp-chapters": {
      "$ref": "https://narrative.dev/schemas/cp-chapters.schema.json"
    },
    "cp-progress": {
      "$ref": "https://narrative.dev/schemas/cp-progress.schema.json"
    },
    "cp-workflow": {
      "$ref": "https://narrative.dev/schemas/cp-workflow.schema.json"
    },
    "cp-approvals": {
      "$ref": "https://narrative.dev/schemas/cp-approvals.schema.json"
    },
    "cp-decisions": {
      "$ref": "https://narrative.dev/schemas/cp-decisions.schema.json"
    },
    "cp-characters": {
      "$ref": "https://narrative.dev/schemas/cp-characters.schema.json"
    },
    "cp-visual-quality": {
      "$ref": "https://narrative.dev/schemas/cp-visual-quality.schema.json"
    }
  }
}
