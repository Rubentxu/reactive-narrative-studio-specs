{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative.dev/schemas/cp-graph.schema.json",
  "title": "Control Plane Graph Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "sourceRevision", "graph"],
  "properties": {
    "schema": {
      "const": "control-plane/graph/v1"
    },
    "generatedAt": {
      "$ref": "#/$defs/isoTimestamp"
    },
    "sourceRevision": {
      "$ref": "#/$defs/sourceRevision"
    },
    "graph": {
      "type": "object",
      "properties": {
        "nodes": { "type": "integer", "minimum": 0 },
        "edges": { "type": "integer", "minimum": 0 },
        "lenses": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": ["pass", "warning", "blocked", "pending", "unknown"]
    }
  },
  "$defs": {
    "isoTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    }
  }
}
