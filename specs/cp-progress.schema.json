{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative.dev/schemas/cp-progress.schema.json",
  "title": "Control Plane Progress Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "sourceRevision", "progress"],
  "properties": {
    "schema": {
      "const": "control-plane/progress/v1"
    },
    "generatedAt": {
      "$ref": "#/$defs/isoTimestamp"
    },
    "sourceRevision": {
      "$ref": "#/$defs/sourceRevision"
    },
    "progress": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["completed", "total"],
        "properties": {
          "completed": { "type": "integer", "minimum": 0 },
          "total": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "enum": ["pass", "warning", "blocked", "pending", "unknown"]
    }
  },
  "$defs": {
    "isoTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    }
  }
}
