{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative.dev/schemas/sequential-ir.schema.json",
  "title": "Sequential Art IR",
  "description": "Intermediate representation for sequential art (comics, manga, graphic novels): panels, gutters, and page layout.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "pages"],
  "properties": {
    "schema": {"const": "sequential-ir/v1"},
    "version": {"type": "string", "const": "1.0"},
    "pages": {
      "type": "array",
      "minItems": 0,
      "items": {"$ref": "#/$defs/Page"}
    }
  },
  "$defs": {
    "Page": {
      "title": "Page",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "panels"],
      "properties": {
        "id": {"type": "string", "pattern": "^page-[a-z0-9-]+$"},
        "panels": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/Panel"}
        },
        "layout": {"$ref": "#/$defs/Layout"}
      }
    },
    "Panel": {
      "title": "Panel",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "shotRef"],
      "properties": {
        "id": {"type": "string", "pattern": "^panel-[a-z0-9-]+$"},
        "shotRef": {"type": "string", "description": "Reference to a Shot in the Visual IR."},
        "caption": {"type": "string"},
        "speech": {
          "type": "array",
          "items": {"$ref": "#/$defs/SpeechBubble"},
          "minItems": 0
        },
        "gutterAfter": {
          "type": "string",
          "enum": ["none", "small", "medium", "large", "scene-break"]
        }
      }
    },
    "SpeechBubble": {
      "title": "Speech Bubble",
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "speaker": {"type": "string"},
        "text": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["speech", "thought", "caption", "sfx"]}
      }
    },
    "Layout": {
      "title": "Layout",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rows": {"type": "integer", "minimum": 1},
        "columns": {"type": "integer", "minimum": 1},
        "template": {"type": "string", "enum": ["grid", "splash", "asymmetric", "modular"]}
      }
    }
  }
}