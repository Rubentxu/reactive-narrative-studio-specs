{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative.dev/schemas/cp-scm.schema.json",
  "title": "Control Plane SCM Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "sourceRevision", "scm"],
  "properties": {
    "schema": {
      "const": "control-plane/scm/v1"
    },
    "generatedAt": {
      "$ref": "#/$defs/isoTimestamp"
    },
    "sourceRevision": {
      "$ref": "#/$defs/sourceRevision"
    },
    "scm": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "repository": { "type": "string" },
        "branch": { "type": "string" },
        "commit": { "type": "string" },
        "status": {
          "enum": ["pass", "warning", "blocked", "pending", "unknown"]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "isoTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    }
  }
}
