{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative.dev/schemas/cp-visual-quality.schema.json",
  "title": "Control Plane Visual Quality Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "sourceRevision", "visualQuality"],
  "properties": {
    "schema": {
      "const": "control-plane/visual-quality/v1"
    },
    "generatedAt": {
      "$ref": "#/$defs/isoTimestamp"
    },
    "sourceRevision": {
      "$ref": "#/$defs/sourceRevision"
    },
    "visualQuality": {
      "type": "object",
      "properties": {
        "continuityStatus": {
          "enum": ["pass", "warning", "blocked", "pending", "unknown"]
        },
        "editorialStatus": {
          "enum": ["pass", "warning", "blocked", "pending", "unknown"]
        },
        "readabilityStatus": {
          "enum": ["pass", "warning", "blocked", "pending", "unknown"]
        },
        "overallStatus": {
          "enum": ["pass", "warning", "blocked", "pending", "unknown"]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "isoTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    }
  }
}
