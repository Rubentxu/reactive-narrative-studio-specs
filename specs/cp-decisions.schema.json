{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative.dev/schemas/cp-decisions.schema.json",
  "title": "Control Plane Decisions Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "sourceRevision", "decisions"],
  "properties": {
    "schema": {
      "const": "control-plane/decisions/v1"
    },
    "generatedAt": {
      "$ref": "#/$defs/isoTimestamp"
    },
    "sourceRevision": {
      "$ref": "#/$defs/sourceRevision"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action", "targetRef", "date", "status"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "targetRef": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z]+:[a-z0-9-]+/[a-z0-9-]+$"
          },
          "date": {
            "$ref": "#/$defs/isoTimestamp"
          },
          "status": {
            "enum": ["accepted", "rejected", "pending", "superseded"]
          },
          "replaces": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "isoTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    }
  }
}
