{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative.dev/schemas/cp-decisions.schema.json",
  "title": "Control Plane Decisions Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "sourceRevision", "decisions"],
  "properties": {
    "schema": {
      "const": "control-plane/decisions/v1"
    },
    "generatedAt": {
      "$ref": "#/$defs/isoTimestamp"
    },
    "sourceRevision": {
      "$ref": "#/$defs/sourceRevision"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sceneRef", "status", "rationale"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sceneRef": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["pending", "accepted", "rejected", "superseded"]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "replaces": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "isoTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    }
  }
}
