{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative.dev/schemas/visual-ir.schema.json",
  "title": "Visual IR",
  "description": "Intermediate representation for visual production: prompts, references, composition, and provider-neutral imagePolicy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "shots"],
  "properties": {
    "schema": {"const": "visual-ir/v1"},
    "version": {"type": "string", "const": "1.0"},
    "shots": {
      "type": "array",
      "minItems": 0,
      "items": {"$ref": "#/$defs/Shot"}
    }
  },
  "$defs": {
    "Shot": {
      "title": "Shot",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "imagePolicy"],
      "properties": {
        "id": {"type": "string", "pattern": "^shot-[a-z0-9-]+$"},
        "prompt": {"type": "string", "minLength": 1},
        "negativePrompt": {"type": "string"},
        "references": {
          "type": "array",
          "items": {"$ref": "#/$defs/Reference"},
          "minItems": 0
        },
        "composition": {"$ref": "#/$defs/Composition"},
        "imagePolicy": {"$ref": "#/$defs/ImagePolicy"}
      }
    },
    "Reference": {
      "title": "Reference",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["character", "location", "prop", "style", "palette"]
        },
        "target": {"type": "string", "minLength": 1}
      }
    },
    "Composition": {
      "title": "Composition",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "framing": {"type": "string", "enum": ["wide", "medium", "close", "extreme-close", "pan", "establishing"]},
        "aspectRatio": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"}
      }
    },
    "ImagePolicy": {
      "title": "Image Policy",
      "description": "Provider-neutral image generation policy. Providers are pluggable; the schema never binds to provider shape.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["local-only", "saas-only", "hybrid"],
          "description": "RE-IMG-7: the runtime must support all three modes."
        },
        "providers": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 0
        },
        "safetyFilter": {"type": "string", "enum": ["strict", "moderate", "off"]}
      }
    }
  }
}