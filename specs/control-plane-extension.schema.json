{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrative.dev/schemas/control-plane-extension-v1.json",
  "title": "Control Plane Extension Configuration",
  "type": "object",
  "required": [
    "schema",
    "extensions"
  ],
  "properties": {
    "schema": {
      "const": "control-plane-extension-config/v1"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "config": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}