{
  "name": "@reactive-narrative/verification-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Verification & Audit Harness (M10.2.1) — independent of production runtime (VAH-001)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
