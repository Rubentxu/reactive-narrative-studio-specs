#!/usr/bin/env bash
# tools/sddk-pack-audit
# Pack overhead audit CLI — taxonomy, gate, and resolve subcommands.
# First multi-subcommand tools/ entry; anchored to check-skill-crossrefs.sh pattern.
set -euo pipefail

# shellcheck disable=SC2317
receipt_file="cycle-artifacts/p-7c4aff45199a2069/m13-debt-resolution-process/cli-receipts.jsonl"

###############################################################################
# Helper: record SC-POL-1 receipt
###############################################################################
record_receipt() {
    local cmd="$1"
    local exit_code="$2"
    shift 2 || true
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    printf '{"argv":%s,"exit_code":%s,"command":"%s","timestamp":"%s"}\n' \
        "$(printf '%s\n' "$0" "$@" | jq -Rs .)" \
        "$exit_code" \
        "$cmd" \
        "$timestamp" \
        >> "$receipt_file"
}

###############################################################################
# dispatch_taxonomy — structural vs content vs contract duplication report
###############################################################################
dispatch_taxonomy() {
    local root="."
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root)
                root="$2"
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done

    echo "=== Pack Taxonomy Report ==="
    echo ""

    # Scan for content duplication: profile-middle-grade-10-11 across pack
    local content_dups=0
    local content_files=()
    while IFS= read -r f; do
        if grep -q 'profile-middle-grade-10-11' "$f" 2>/dev/null; then
            content_dups=$((content_dups + 1))
            content_files+=("  $f")
        fi
    done < <(find "$root/specs" "$root/examples" "$root/templates" "$root/docs" \( -name "*.yaml" -o -name "*.md" \) -type f 2>/dev/null | sort)

    echo "Content duplication axis (contract=None; content duplication confirmed):"
    echo "  profile-middle-grade-10-11 appears in $content_dups files:"
    for f in "${content_files[@]}"; do
        echo "$f"
    done
    echo ""

    # Structural duplication: check for similar file shapes
    echo "Structural duplication axis:"
    local profile_yaml
    profile_yaml=$(find "$root/examples" -name "*-profile.yaml" 2>/dev/null | wc -l)
    echo "  Found $profile_yaml profile YAML files (structural skeleton pattern)"
    echo ""

    # Contract duplication: alias registry vs canonical
    echo "Contract duplication axis:"
    if [[ -f "$root/specs/profile-aliases.yaml" ]]; then
        echo "  specs/profile-aliases.yaml declares alias registry"
    fi
    if [[ -f "$root/examples/middle-grade-profile.yaml" ]]; then
        echo "  examples/middle-grade-profile.yaml declares canonical profile contract"
    fi
    echo "  Contract duplication: alias registry at specs/profile-aliases.yaml vs canonical at examples/middle-grade-profile.yaml:2"
    echo ""

    echo "=== Axes Summary ==="
    echo "structural: YES ($profile_yaml profile YAML files share skeleton)"
    echo "content: YES (profile-middle-grade-10-11 in $content_dups files)"
    echo "contract: YES (alias registry vs canonical profile)"
    echo ""
    echo "taxonomy PASS"
    return 0
}

###############################################################################
# dispatch_gate — pack-overhead review gate (PASS/WARN/FAIL)
###############################################################################
dispatch_gate() {
    local root="."
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root)
                root="$2"
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done

    # Count metrics
    local adr_count man_entry_count tool_count

    adr_count=$(find "$root/docs/adrs" -name "ADR-*.md" 2>/dev/null | wc -l)
    man_entry_count=$(jq '.documents | length' "$root/MANIFEST.json" 2>/dev/null || echo "0")
    tool_count=$(find "$root/tools" -type f -executable 2>/dev/null | wc -l)

    # Threshold checks (baseline: 25 ADRs, 127 MANIFEST entries, 1 tool entry)
    local adr_cap=26
    local adr_budget=25
    local man_budget=127
    local tool_budget=1

    local adr_overhead=0 man_overhead=0 tool_overhead=0
    local warn_flag=0 fail_flag=0

    # ADR check
    if (( adr_count > adr_cap )); then
        echo "ADR check: FAIL (count=$adr_count, cap=$adr_cap)"
        fail_flag=1
    elif (( adr_count > adr_budget )); then
        local pct=$(( (adr_count - adr_budget) * 100 / adr_budget ))
        if (( pct > 25 )); then
            echo "ADR check: FAIL (count=$adr_count, budget=$adr_budget, +${pct}% over)"
            fail_flag=1
        else
            echo "ADR check: WARN (count=$adr_count, budget=$adr_budget, +${pct}% over, within 25%)"
            warn_flag=1
        fi
    else
        echo "ADR check: PASS (count=$adr_count, budget=$adr_budget)"
    fi

    # MANIFEST check
    if (( man_entry_count > man_budget )); then
        local pct=$(( (man_entry_count - man_budget) * 100 / man_budget ))
        if (( pct > 25 )); then
            echo "MANIFEST check: FAIL (count=$man_entry_count, budget=$man_budget, +${pct}% over)"
            fail_flag=1
        else
            echo "MANIFEST check: WARN (count=$man_entry_count, budget=$man_budget, +${pct}% over, within 25%)"
            warn_flag=1
        fi
    else
        echo "MANIFEST check: PASS (count=$man_entry_count, budget=$man_budget)"
    fi

    # Tool surface check
    if (( tool_count > tool_budget )); then
        local tool_pct=$(( (tool_count - tool_budget) * 100 / tool_budget ))
        if (( tool_pct > 25 )); then
            echo "Tool surface check: FAIL (count=$tool_count, budget=$tool_budget, +${tool_pct}% over)"
            fail_flag=1
        else
            echo "Tool surface check: WARN (count=$tool_count, budget=$tool_budget, +${tool_pct}% over, within 25%)"
            warn_flag=1
        fi
    else
        echo "Tool surface check: PASS (count=$tool_count, budget=$tool_budget)"
    fi

    echo ""
    if (( fail_flag )); then
        echo "FAIL"
        return 1
    elif (( warn_flag )); then
        echo "WARN"
        return 0
    else
        echo "PASS"
        return 0
    fi
}

###############################################################################
# dispatch_resolve — {{ profiles.<id> }} deref against specs/profile-aliases.yaml
###############################################################################
dispatch_resolve() {
    local placeholder=""
    local root="."

    # Parse arguments: first non-flag is placeholder, then --root flag
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root)
                root="$2"
                shift 2
                ;;
            *)
                placeholder="$1"
                shift
                ;;
        esac
    done

    # Strip {{ }} and profiles. prefix/suffix
    local alias_id
    alias_id=$(echo "$placeholder" | sed -E 's/^\{\{\s*profiles\.//; s/\s*\}\}$//')

    if [[ -z "$alias_id" ]]; then
        echo "ERROR: empty alias id" >&2
        echo "Usage: $0 resolve '{{ profiles.<id> }}' [--root <path>]" >&2
        return 1
    fi

    local registry="$root/specs/profile-aliases.yaml"
    if [[ ! -f "$registry" ]]; then
        echo "ERROR: registry not found: $registry" >&2
        return 1
    fi

    # Extract canonical_name for the given id using awk
    local canonical
    canonical=$(awk -v pat="id: $alias_id" '
        $0 ~ pat { found = 1 }
        found && /canonical_name:/ {
            match($0, /"[^"]+"/)
            print substr($0, RSTART+1, RLENGTH-2)
            exit
        }
    ' "$registry")

    if [[ -z "$canonical" ]]; then
        echo "ERROR: unknown alias '$alias_id'" >&2
        return 1
    fi

    echo "$canonical"
    return 0
}

###############################################################################
# Main dispatcher
###############################################################################
cmd="${1:-}"; shift || true

case "$cmd" in
    taxonomy)
        argv_backup=("$@")
        dispatch_taxonomy "$@" || exit_code=$?
        record_receipt "taxonomy" "${exit_code:-0}" "${argv_backup[@]}"
        _ec="${exit_code:-0}"
        unset exit_code
        exit "$_ec"
        ;;
    gate)
        argv_backup=("$@")
        dispatch_gate "$@" || exit_code=$?
        record_receipt "gate" "${exit_code:-0}" "${argv_backup[@]}"
        _ec="${exit_code:-0}"
        unset exit_code
        exit "$_ec"
        ;;
    resolve)
        argv_backup=("$@")
        dispatch_resolve "$@" || exit_code=$?
        record_receipt "resolve" "${exit_code:-0}" "${argv_backup[@]}"
        _ec="${exit_code:-0}"
        unset exit_code
        exit "$_ec"
        ;;
    *)
        echo "Usage: $0 {taxonomy|gate|resolve} [--root <path>]" >&2
        echo "" >&2
        echo "Commands:" >&2
        echo "  taxonomy  -- structural/content/contract duplication report" >&2
        echo "  gate     -- pack-overhead review gate (PASS|WARN|FAIL)" >&2
        echo "  resolve  -- dereference {{ profiles.<id> }} against alias registry" >&2
        exit 1
        ;;
esac
